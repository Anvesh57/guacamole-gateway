guacConfigParameter: hostname=linux-server-1
guacConfigParameter: port=22
guacConfigParameter: username=npa_ssh1
guacConfigParameter:: @@SSH1_PASSWORD_PARAMETER_B64@@
guacConfigParameter: font-name=monospace
