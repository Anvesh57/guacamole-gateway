# guacConfigGroup inherits the mandatory member attribute from groupOfNames.
# A group DN satisfies that schema requirement without granting any user
# direct access. seeAlso is the actual Guacamole group authorization mapping.
dn: cn=Linux Desktop,ou=connections,dc=example,dc=org
objectClass: guacConfigGroup
cn: Linux Desktop
member: cn=Desktop users,ou=groups,dc=example,dc=org
seeAlso: cn=Desktop users,ou=groups,dc=example,dc=org
guacConfigProtocol: rdp
guacConfigParameter: hostname=linux-desktop
guacConfigParameter: port=3389
guacConfigParameter: username=npa_desktop
guacConfigParameter:: @@DESKTOP_PASSWORD_PARAMETER_B64@@
guacConfigParameter: security=tls
guacConfigParameter: ignore-cert=true
guacConfigParameter: resize-method=display-update
guacConfigParameter: disable-audio=true
guacConfigParameter: server-layout=en-us-qwerty

